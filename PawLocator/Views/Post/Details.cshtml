@model PawLocator.DTOs.PostDto

<h2>@Model.Title</h2>

<p>@Model.Description</p>
<p>@Model.Location</p>

<hr />

<h3>Updates</h3>

@if (Model.Updates.Any())
{
    foreach (var update in Model.Updates.OrderByDescending(u => u.CreatedAt))
    {
        <div class="card mb-2">
            <div class="card-body">
                <p>@update.Message</p>
                <small>@update.CreatedAt</small>
            </div>
        </div>
    }
}
else
{
    <p>No updates yet.</p>
}

<a asp-controller="Update"
   asp-action="Create"
   asp-route-postId="@Model.Id"
   class="btn btn-primary mb-3">
    ➕ Add Update
</a>

<a asp-controller="Post"
   asp-action="Index"
   class="btn btn-secondary mb-3">
    Back
</a>